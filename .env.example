OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# docker compose: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# Must reference the same user/password/db set below.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
HC_HOLDER_PHONE=
HC_MEMBER_PHONE=
TOKEN_ENCRYPTION_KEY=
# 32+ random bytes — e.g. `openssl rand -hex 32`. Short values trigger PyJWT's
# InsecureKeyLengthWarning (RFC 7518 minimum for HS256).
JWT_SECRET=
# Local dev: http://localhost:8765/oauth/callback
# Production (whitelisted with Swiggy): https://humaracart.mridulabs.dev/oauth/callback
OAUTH_REDIRECT_URI=
# Optional. Set in production only (e.g. https://humaracart.mridulabs.dev) —
# enables Twilio status_callback logging for outbound messages (POST /webhook/status).
# Leave empty for local dev.
PUBLIC_BASE_URL=
